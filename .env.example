# Copie este archivo como .env (misma carpeta de run.py) y complete sus datos.

# Servidor a usar: local  o  neon
SEO_BD_PERFIL=local

# ---------- PostgreSQL instalado en el equipo ----------
LOCAL_BD_HOST=localhost
LOCAL_BD_PUERTO=5432
LOCAL_BD_NOMBRE=sistema_experto_orientacion
LOCAL_BD_USUARIO=postgres
LOCAL_BD_CLAVE=postgres
LOCAL_BD_SSL=prefer

# ---------- PostgreSQL en la nube (Neon, botón Connect) ----------
NEON_BD_HOST=ep-xxxx.us-east-2.aws.neon.tech
NEON_BD_PUERTO=5432
NEON_BD_NOMBRE=neondb
NEON_BD_USUARIO=neondb_owner
NEON_BD_CLAVE=su_clave_de_neon
NEON_BD_SSL=require

# ---------- Aplicación web ----------
# Clave para firmar las sesiones. Genere una con:  python -c "import secrets; print(secrets.token_hex(32))"
SEO_CLAVE_SECRETA=cambie_esta_clave
SEO_PUERTO_WEB=5000
